  8:"מצאו את מסך ה-404 הכי מוזר/מצחיק שנתקלתם בו אי פעם ברשת, ואז עצבו לו גרסה טובה יותר משלכם.",
  9:"בנו פלטת צבעים וטיפוגרפיה שלמה למותג דמיוני: 'בית קפה לרובוטים' — כן, גם לרובוטים מגיע אספרסו יפה.",
  10:"עצבו 5 קומפוננטות בסיסיות למערכת עיצוב של קרקס דיגיטלי: כפתורים שמתהפכים, כרטיסים שקופצים, ועוד.",
  11:"המציאו North Star Metric משוגע-אך-הגיוני למוצר דמיוני: אפליקציה לתיאום חלומות משותפים בין חברים.",
  12:"כתבו כותרת קליקבייט (אבל אמיתית ומדויקת) לפרויקט הגמר שלכם, כאילו הוא כתבה ראשית ב-TechCrunch."
};

/* ======================= STATE & STORAGE ======================= */
let completed = new Set();
let currentDetailId = null;
let history = ['dashboard'];
let activeTab = 'dashboard';
let cameFromTab = 'sessions';

function loadProgress(){
  try{
    const raw = localStorage.getItem('pd_course_progress');
    if(raw){ completed = new Set(JSON.parse(raw)); }
  }catch(e){ completed = new Set(); }
  render();
}
function saveProgress(){
  try{ localStorage.setItem('pd_course_progress', JSON.stringify([...completed])); }catch(e){}
}

/* ======================= RENDER ======================= */
function render(){
  renderDashboard();
  renderSessionsList();
  updateProgressBar();
}

function updateProgressBar(){
  const pct = Math.round((completed.size / sessions.length) * 100);
  document.getElementById('progFill').style.width = pct + '%';
  document.getElementById('progPct').textContent = pct + '%';
}

function renderDashboard(){
  const wrap = document.getElementById('monthCards');
  wrap.innerHTML = months.map(m=>{
    const msess = sessions.filter(s=>s.month===m.n);
    const weeksArr = [...new Set(msess.map(s=>s.week))];
    const nodes = weeksArr.map(w=>{
      const wSess = sessions.filter(s=>s.week===w);
      const done = wSess.every(s=>completed.has(s.id));
      return `<i class="${done?'done':''}"></i>`;
    }).join('');
    return `<div class="month-card" onclick="openMonth(${m.n})">
      <div class="mtitle"><h3>חודש ${m.n} — ${m.title}</h3></div>
      <small>${m.weeks}</small>
      <p>${m.desc}</p>
      <div class="weeknodes">${nodes}</div>
    </div>`;
  }).join('');
}

function renderSessionsList(){
  const wrap = document.getElementById('sessionsList');
  const weeks = [...new Set(sessions.map(s=>s.week))];
  wrap.innerHTML = weeks.map(w=>{
    const wSess = sessions.filter(s=>s.week===w);
    const mNum = wSess[0].month;
    const fun = funProjects[w] ? `<div class="funcard">🎨 <b>פרויקט יצירתי (רשות):</b> ${funProjects[w]}</div>` : '';
    return `<div class="weekgroup">
      <h4>שבוע ${w} · חודש ${mNum}</h4>
      ${wSess.map(s=>sessCardHTML(s)).join('')}
      ${fun}
    </div>`;
  }).join('');
}

function sessCardHTML(s){
  const isExam = s.type.includes('מבחן') || s.type.includes('הגשה') || s.type.includes('הצגה');
  const done = completed.has(s.id);
  return `<div class="sess-card" onclick="openDetail(${s.id})">
    <div class="sess-num ${isExam?'exam':''}">${s.id}</div>
    <div class="sess-info">
      <div class="day">${s.day}${isExam?' · '+s.type:''}</div>
      <div class="ttl">${s.title}</div>
    </div>
    <div class="stampmark ${done?'on':''}">${done?'✓':''}</div>
  </div>`;
}

function openMonth(n){
  showTab('sessions');
  setTimeout(()=>{
    const el = document.querySelector('.weekgroup h4');
  },0);
}

function openDetail(id, fromTab){
  if(fromTab) cameFromTab = fromTab; else if(activeTab!=='dashboard') cameFromTab = activeTab;
  currentDetailId = id;
  const s = sessions.find(x=>x.id===id);
  const isExam = s.type.includes('מבחן') || s.type.includes('הגשה') || s.type.includes('הצגה');
  const done = completed.has(id);
  const fun = funProjects[s.week] ? `<div class="funcard">🎨 <b>פרויקט יצירתי (רשות):</b> ${funProjects[s.week]}</div>` : '';
  const html = `
    <span class="badge ${isExam?'exam':''}">${s.day} · ${s.type}</span>
    <div class="detail">
      <h2>${s.title}</h2>
      <div class="meta">חודש ${s.month} · שבוע ${s.week} · מפגש ${s.id} מתוך ${sessions.length}</div>
      <div class="goalbox">🎯 ${s.goal}</div>

      <div class="block"><h3>מונחים מקצועיים</h3>
        ${s.terms.map(t=>`<span class="termtag">${t}</span>`).join('')}
      </div>

      <div class="block"><h3>Case Study</h3>
        <div class="casebox"><b>${s.caseName}</b><p>${s.caseText}</p></div>
      </div>

      <div class="block"><h3>${isExam?'מטלה':'משימה / מטלה מתפרצת'}</h3>
        <div class="taskbox">${s.task}</div>
      </div>

      ${s.res.length? `<div class="block"><h3>קריאה והעמקה — קישורים ישירים</h3>
        <div class="reslist">${s.res.map(r=>`<a href="${r.u}" target="_blank" rel="noopener">${r.l}<span class="arrow">↗</span></a>`).join('')}</div>
      </div>` : ''}

      ${fun}

      <button class="completebtn ${done?'done':''}" id="completeBtn" onclick="toggleComplete(${id})">
        ${done?'✓ מפגש הושלם':'סמנו כהושלם'}
      </button>

      <div class="navpair">
        <button onclick="navSession(-1)">← מפגש קודם</button>
        <button onclick="navSession(1)">מפגש הבא →</button>
      </div>

      <div class="block" style="margin-top:26px;">
        <h3>ההגשה שלי</h3>
        <div class="subbox">
          <textarea id="subText" placeholder="כתבו כאן תשובה, סיכום או רפלקציה על המשימה..."></textarea>
          <input type="file" id="subFile" accept="image/*,.pdf,.doc,.docx" onchange="previewSubFile()">
          <div id="subFilePreview"></div>
          <button class="savebtn" onclick="saveSubmission(${id})">💾 שמרו הגשה למפגש זה</button>
        </div>
        <div class="sublist" id="sessionSubList"></div>
      </div>
    </div>`;
  document.getElementById('detailContent').innerHTML = html;
  navigateTo('view-detail');
  document.getElementById('backBtn').style.display = 'inline-block';
  renderSessionSubmissions(id);
}

function navSession(dir){
  const idx = sessions.findIndex(s=>s.id===currentDetailId);
  const next = idx + dir;
  if(next>=0 && next<sessions.length){ openDetail(sessions[next].id); }
}

function toggleComplete(id){
  if(completed.has(id)) completed.delete(id); else completed.add(id);
  saveProgress();
  render();
  openDetail(id);
}

/* ======================= NAVIGATION ======================= */
function showTab(tab){
  activeTab = tab;
  document.getElementById('tab-dashboard').classList.toggle('active', tab==='dashboard');
  document.getElementById('tab-sessions').classList.toggle('active', tab==='sessions');
  document.getElementById('tab-submissions').classList.toggle('active', tab==='submissions');
  const viewMap = {dashboard:'view-dashboard', sessions:'view-sessions', submissions:'view-submissions'};
  navigateTo(viewMap[tab]);
  document.getElementById('backBtn').style.display = 'none';
  if(tab==='submissions'){ renderAllSubmissions(); }
}

function navigateTo(viewId){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById(viewId).classList.add('active');
  window.scrollTo(0,0);
}

function goBack(){
  showTab(cameFromTab || 'sessions');
}

/* ======================= TOAST ======================= */
let toastTimer = null;
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 2600);
}

/* ======================= SUBMISSIONS: INDEXEDDB ======================= */
let subDB = null;
function openSubDB(){
  return new Promise((resolve, reject)=>{
    if(subDB){ resolve(subDB); return; }
    const req = indexedDB.open('pd_course_submissions', 1);
    req.onupgradeneeded = (e)=>{
      const db = e.target.result;
      if(!db.objectStoreNames.contains('submissions')){
        const store = db.createObjectStore('submissions', {keyPath:'id'});
        store.createIndex('sessionId', 'sessionId', {unique:false});
      }
    };
    req.onsuccess = (e)=>{ subDB = e.target.result; resolve(subDB); };
    req.onerror = (e)=>{ reject(e); };
  });
}

function addSubmissionToDB(obj){
  return openSubDB().then(db=>new Promise((resolve, reject)=>{
    const tx = db.transaction('submissions', 'readwrite');
    tx.objectStore('submissions').put(obj);
    tx.oncomplete = ()=>resolve(obj);
    tx.onerror = (e)=>reject(e);
  }));
}

function getSubmissionsBySession(sessionId){
  return openSubDB().then(db=>new Promise((resolve, reject)=>{
    const tx = db.transaction('submissions', 'readonly');
    const idx = tx.objectStore('submissions').index('sessionId');
    const req = idx.getAll(sessionId);
    req.onsuccess = ()=>resolve(req.result.sort((a,b)=>b.timestamp-a.timestamp));
    req.onerror = (e)=>reject(e);
  }));
}

function getAllSubmissionsFromDB(){
  return openSubDB().then(db=>new Promise((resolve, reject)=>{
    const tx = db.transaction('submissions', 'readonly');
    const req = tx.objectStore('submissions').getAll();
    req.onsuccess = ()=>resolve(req.result.sort((a,b)=>b.timestamp-a.timestamp));
    req.onerror = (e)=>reject(e);
  }));
}

function deleteSubmissionFromDB(id){
  return openSubDB().then(db=>new Promise((resolve, reject)=>{
    const tx = db.transaction('submissions', 'readwrite');
    tx.objectStore('submissions').delete(id);
    tx.oncomplete = ()=>resolve();
    tx.onerror = (e)=>reject(e);
  }));
}

/* ======================= SUBMISSIONS: FILE PREVIEW ======================= */
let pendingFileData = null; // {name, type, dataUrl}
function previewSubFile(){
  const input = document.getElementById('subFile');
  const file = input.files[0];
  const previewEl = document.getElementById('subFilePreview');
  if(!file){ pendingFileData = null; previewEl.innerHTML=''; return; }
  if(file.size > 4*1024*1024){
    showToast('הקובץ גדול מ-4MB — נסו קובץ קטן יותר');
    input.value = '';
    pendingFileData = null; previewEl.innerHTML='';
    return;
  }
  const reader = new FileReader();
  reader.onload = ()=>{
    pendingFileData = {name:file.name, type:file.type, dataUrl:reader.result};
    const isImg = file.type.startsWith('image/');
    previewEl.innerHTML = `<div class="filepreview">${isImg?`<img src="${reader.result}">`:'📄'}<span>${file.name}</span></div>`;
  };
  reader.readAsDataURL(file);
}

/* ======================= SUBMISSIONS: SAVE / RENDER ======================= */
function saveSubmission(sessionId){
  const text = document.getElementById('subText').value.trim();
  if(!text && !pendingFileData){
    showToast('כתבו טקסט או צרפו קובץ לפני השמירה');
    return;
  }
  const s = sessions.find(x=>x.id===sessionId);
  const obj = {
    id: 'sub_' + Date.now() + '_' + Math.random().toString(36).slice(2,7),
    sessionId: sessionId,
    sessionTitle: s.title,
    text: text,
    fileName: pendingFileData ? pendingFileData.name : null,
    fileType: pendingFileData ? pendingFileData.type : null,
    fileDataUrl: pendingFileData ? pendingFileData.dataUrl : null,
    timestamp: Date.now()
  };
  addSubmissionToDB(obj).then(()=>{
    document.getElementById('subText').value = '';
    document.getElementById('subFile').value = '';
    document.getElementById('subFilePreview').innerHTML = '';
    pendingFileData = null;
    showToast('ההגשה נשמרה ✓');
    renderSessionSubmissions(sessionId);
  }).catch(()=>showToast('שגיאה בשמירה — נסו שוב'));
}

function fmtDate(ts){
  const d = new Date(ts);
  return d.toLocaleDateString('he-IL', {day:'2-digit', month:'2-digit', year:'numeric'}) + ' · ' + d.toLocaleTimeString('he-IL', {hour:'2-digit', minute:'2-digit'});
}

function subItemHTML(sub, showSession){
  const fileLine = sub.fileName ? `<div class="subfile">📎 ${sub.fileName}</div>` : '';
  const sessionLine = showSession ? `<div class="allsub-session">מפגש ${sub.sessionId} · ${sub.sessionTitle}</div>` : '';
  return `<div class="subitem" id="subitem_${sub.id}">
    ${sessionLine}
    <div class="subdate">${fmtDate(sub.timestamp)}</div>
    ${sub.text ? `<div class="subtext">${escapeHtml(sub.text)}</div>` : ''}
    ${fileLine}
    <div class="subactions">
      <button onclick="shareSubmission('${sub.id}')">↗ שיתוף</button>
      <button onclick="copyForChat('${sub.id}')">💬 העתקה לצ'אט</button>
      <button class="danger" onclick="removeSubmission('${sub.id}', ${sub.sessionId})">מחיקה</button>
    </div>
  </div>`;
}

function escapeHtml(str){
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function renderSessionSubmissions(sessionId){
  const el = document.getElementById('sessionSubList');
  if(!el) return;
  getSubmissionsBySession(sessionId).then(subs=>{
    if(!subs.length){ el.innerHTML = ''; return; }
    el.innerHTML = `<div class="subheader"><span style="font-size:13px;color:var(--slate);">הגשות שמורות</span><span class="subcount">${subs.length}</span></div>` +
      subs.map(s=>subItemHTML(s, false)).join('');
  }).catch(()=>{ el.innerHTML=''; });
}

function renderAllSubmissions(){
  const el = document.getElementById('allSubmissionsList');
  getAllSubmissionsFromDB().then(subs=>{
    if(!subs.length){
      el.innerHTML = `<div style="text-align:center;color:var(--slate);padding:40px 10px;font-size:14px;">עדיין לא שמרת הגשות.<br>פתחו מפגש ולחצו על "שמרו הגשה" בתחתית העמוד.</div>`;
      return;
    }
    el.innerHTML = subs.map(s=>subItemHTML(s, true)).join('');
  }).catch(()=>{ el.innerHTML = '<div style="color:var(--slate);padding:20px;">שגיאה בטעינת ההגשות</div>'; });
}

/* ======================= SUBMISSIONS: SHARE / COPY / DELETE ======================= */
function buildChatText(sub){
  let out = `קורס עיצוב מוצר — הגשה למפגש ${sub.sessionId}: ${sub.sessionTitle}\n\n`;
  if(sub.text) out += sub.text + '\n\n';
  if(sub.fileName) out += `(קובץ מצורף בשם "${sub.fileName}" — יש לצרף אותו בנפרד כאן בצ'אט)\n\n`;
  out += 'אשמח לקבל משוב על ההגשה הזו.';
  return out;
}

async function dataUrlToFile(dataUrl, filename, mimeType){
  const res = await fetch(dataUrl);
  const blob = await res.blob();
  return new File([blob], filename, {type: mimeType});
}

async function shareSubmission(id){
  getAllSubmissionsFromDB().then(async (all)=>{
    const sub = all.find(s=>s.id===id);
    if(!sub) return;
    const text = buildChatText(sub);
    try{
      if(navigator.share){
        let shareData = {title:'הגשה — ' + sub.sessionTitle, text: text};
        if(sub.fileDataUrl && navigator.canShare){
          const file = await dataUrlToFile(sub.fileDataUrl, sub.fileName, sub.fileType);
          if(navigator.canShare({files:[file]})){ shareData.files = [file]; }
        }
        await navigator.share(shareData);
      } else {
        await navigator.clipboard.writeText(text);
        showToast('שיתוף לא נתמך בדפדפן זה — הטקסט הועתק');
      }
    }catch(e){
      if(e.name !== 'AbortError'){ showToast('השיתוף לא הצליח'); }
    }
  });
}

function copyForChat(id){
  getAllSubmissionsFromDB().then(async (all)=>{
    const sub = all.find(s=>s.id===id);
    if(!sub) return;
    const text = buildChatText(sub);
    try{
      await navigator.clipboard.writeText(text);
      showToast('הועתק! עברו לצ׳אט עם Claude והדביקו לקבלת משוב');
    }catch(e){
      showToast('ההעתקה לא הצליחה בדפדפן זה');
    }
  });
}

function removeSubmission(id, sessionId){
  if(!confirm('למחוק את ההגשה הזו?')) return;
  deleteSubmissionFromDB(id).then(()=>{
    showToast('ההגשה נמחקה');
    if(document.getElementById('sessionSubList')) renderSessionSubmissions(sessionId);
    if(activeTab==='submissions') renderAllSubmissions();
  });
}

/* ======================= INIT ======================= */
loadProgress();
